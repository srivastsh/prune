{
  "manifest_version": 3,
  "name": "Prune for X",
  "short_name": "Prune",
  "version": "0.1.0",
  "description": "Find the dead accounts you follow on X, sorted by last post, and unfollow them at a safe pace. Runs entirely in your browser.",
  "homepage_url": "https://github.com/srivastsh/prune",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Prune",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://abs.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
